# Anthropic API key — required ONLY for the daily summary feature.
# The dashboard, token tracking, and session views work without it.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Directory where Claude Code writes JSONL session logs.
# Defaults to ~/.claude/projects when unset.
# Override if your Claude Code install writes logs elsewhere.
# CLAUDE_PROJECTS_DIR=

# Directory where the dashboard writes daily AI summaries (markdown).
# Defaults to ./data/summaries when unset (relative to project root).
# Override to put summaries somewhere global, e.g. ~/Documents/claude-summaries
# SUMMARIES_DIR=
